<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales_report" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="FROM_DATE" class="java.lang.String"/>
    <parameter name="TO_DATE" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT c.name AS customer_name, e.name AS employee_name, p.name AS product_name,
               cat.name AS category_name, oi.qty, oi.unit_price, oi.subtotal,
               DATE_FORMAT(so.order_date, '%Y-%m-%d %H:%i') AS order_date, so.status
        FROM sales_order so
        JOIN customer c ON so.customer_id = c.customer_id
        JOIN employee e ON so.employee_id = e.employee_id
        JOIN order_item oi ON so.order_id = oi.order_id
        JOIN product p ON oi.product_id = p.product_id
        JOIN category cat ON p.category_id = cat.category_id
        WHERE ($P{FROM_DATE} IS NULL OR $P{FROM_DATE} = '' OR DATE(so.order_date) >= $P{FROM_DATE})
          AND ($P{TO_DATE} IS NULL OR $P{TO_DATE} = '' OR DATE(so.order_date) <= $P{TO_DATE})
        ORDER BY so.order_date DESC
        ]]>
    </queryString>

    <field name="customer_name" class="java.lang.String"/>
    <field name="employee_name" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="category_name" class="java.lang.String"/>
    <field name="qty" class="java.lang.Integer"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="order_date" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <variable name="TOTAL_REVENUE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
    </variable>
    <variable name="TOTAL_QTY" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{qty}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="58" backcolor="#0F172A"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="58" width="555" height="3" backcolor="#2563EB"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="300" height="24" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Apex PC & Tech — Sales Report]]></text>
            </staticText>
            <staticText>
                <reportElement x="15" y="36" width="260" height="16" forecolor="#93C5FD"/>
                <textElement>
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[Hardware, PC Components & Sales Analytics]]></text>
            </staticText>
            <textField>
                <reportElement x="330" y="36" width="210" height="16" forecolor="#CBD5E1"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{FROM_DATE} + " to " + $P{TO_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#F1F5F9"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line>
                <reportElement x="0" y="24" width="555" height="1" forecolor="#CBD5E1"/>
            </line>
            <staticText>
                <reportElement x="5" y="5" width="90" height="15" forecolor="#0F172A"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="5" width="105" height="15" forecolor="#0F172A"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="5" width="70" height="15" forecolor="#0F172A"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="285" y="5" width="30" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="5" width="65" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="5" width="70" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="5" width="85" height="15" forecolor="#0F172A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="5" y="2" width="90" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="2" width="105" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="210" y="2" width="70" height="15"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{category_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="285" y="2" width="30" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="320" y="2" width="65" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="390" y="2" width="70" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="465" y="2" width="85" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="19" width="555" height="1" forecolor="#E2E8F0"/>
            </line>
        </band>
    </detail>

    <summary>
        <band height="50">
            <rectangle>
                <reportElement x="0" y="10" width="555" height="35" backcolor="#F8FAFC"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#CBD5E1"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="20" width="100" height="16" forecolor="#0F172A"/>
                <textElement>
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Summary Totals:]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="20" width="140" height="16" forecolor="#64748B"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Qty Sold: " + ($V{TOTAL_QTY} != null ? $V{TOTAL_QTY} : 0)]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="20" width="210" height="16" forecolor="#2563EB"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Revenue: Rs. " + ($V{TOTAL_REVENUE} != null ? String.format("%,.2f", $V{TOTAL_REVENUE}) : "0.00")]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
